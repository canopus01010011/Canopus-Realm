<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="app.RPSController" prefWidth="600" prefHeight="400">

    <top>
        <Label text="⚔ Rock Paper Scissors ⚔" styleClass="title" BorderPane.alignment="CENTER"/>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20">
            <HBox alignment="CENTER" spacing="15">
                <Button text="🪨 Rock" fx:id="rockBtn" onAction="#handleChoice" styleClass="rps-btn"/>
                <Button text="📄 Paper" fx:id="paperBtn" onAction="#handleChoice" styleClass="rps-btn"/>
                <Button text="✂ Scissors" fx:id="scissorsBtn" onAction="#handleChoice" styleClass="rps-btn"/>
            </HBox>

            <Label fx:id="resultLabel" text="Make your move!" styleClass="result"/>

            <HBox alignment="CENTER" spacing="30">
                <Label fx:id="playerScore" text="Player: 0" styleClass="score"/>
                <Label fx:id="computerScore" text="Computer: 0" styleClass="score"/>
            </HBox>

            <Button text="🔄 Reset Game" onAction="#resetGame" styleClass="reset-btn"/>
        </VBox>
    </center>
</BorderPane>
