rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---------------------------------------------------------
    // /users/{uid}                — private profile
    // /users/{uid}/anime-list/*   — private watchlist entries
    // ---------------------------------------------------------
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt']);
      allow update: if isOwner(uid);
      allow delete: if false;

      match /anime-list/{animeId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ---------------------------------------------------------
    // /anime/{malId}              — public aggregate rating
    // /anime/{malId}/reviews/{uid} — one review per user, public read
    // ---------------------------------------------------------
    match /anime/{animeId} {
      allow read: if true;

      // Aggregate fields are only allowed to move by an amount
      // consistent with a single review from the requesting user.
      // This gives reasonable protection against casual tampering,
      // but a fully tamper-proof aggregate (immune to a client that
      // calls the REST API directly) requires moving this logic into
      // a trusted environment, e.g. a Cloud Function triggered on
      // writes to the reviews subcollection. Swap this rule for a
      // server-only write once that function exists.
      allow create: if isSignedIn()
        && request.resource.data.ratingCount == 1
        && request.resource.data.ratingSum >= 1
        && request.resource.data.ratingSum <= 5;

      allow update: if isSignedIn()
        && request.resource.data.ratingCount >= resource.data.ratingCount
        && request.resource.data.ratingCount <= resource.data.ratingCount + 1
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['ratingSum', 'ratingCount', 'updatedAt', 'title', 'malId']);

      match /reviews/{userId} {
        allow read: if true;

        allow create: if isOwner(userId)
          && request.resource.data.authorId == userId
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500;

        allow update: if isOwner(userId)
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500;

        allow delete: if isOwner(userId);
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
